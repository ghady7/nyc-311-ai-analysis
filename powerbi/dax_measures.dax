-- ==============================================================================
-- NYC 311 ANALYTICS SYSTEM: POWER BI DAX MEASURES SPECIFICATION
-- Table: _Measures
-- ==============================================================================

-- ------------------------------------------------------------------------------
-- FOLDER: 01 Volume & Operations
-- ------------------------------------------------------------------------------

Total Complaints = 
COUNTROWS(fact_complaints)

Closed Complaints = 
CALCULATE(
    COUNTROWS(fact_complaints),
    fact_complaints[is_closed] = TRUE
)

Open Complaints = 
CALCULATE(
    COUNTROWS(fact_complaints),
    fact_complaints[is_closed] = FALSE
)

Resolution Rate % = 
DIVIDE([Closed Complaints], [Total Complaints], 0)


-- ------------------------------------------------------------------------------
-- FOLDER: 02 SLA & Performance
-- ------------------------------------------------------------------------------

Avg Resolution Hours = 
AVERAGE(fact_complaints[resolution_hours])

Median Resolution Hours = 
MEDIAN(fact_complaints[resolution_hours])

SLA Compliant Complaints = 
CALCULATE(
    COUNTROWS(fact_complaints),
    fact_complaints[is_sla_compliant] = TRUE
)

SLA Evaluated Complaints = 
CALCULATE(
    COUNTROWS(fact_complaints),
    NOT(ISBLANK(fact_complaints[is_sla_compliant]))
)

SLA Compliance Rate % = 
DIVIDE([SLA Compliant Complaints], [SLA Evaluated Complaints], 0)


-- ------------------------------------------------------------------------------
-- FOLDER: 03 Pipeline Health & Data Quarantine
-- ------------------------------------------------------------------------------

Quarantined Complaints = 
COUNTROWS(quarantine_complaints)

Raw Complaints Evaluated = 
[Total Complaints] + [Quarantined Complaints]

Pipeline Data Pass Rate % = 
DIVIDE([Total Complaints], [Raw Complaints Evaluated], 0)

Quarantine Rate % = 
DIVIDE([Quarantined Complaints], [Raw Complaints Evaluated], 0)

Chronology Violations = 
CALCULATE(
    COUNTROWS(quarantine_complaints),
    quarantine_complaints[rejection_reason] = "CHRONOLOGY_VIOLATION"
)

Unassigned Boroughs = 
CALCULATE(
    COUNTROWS(quarantine_complaints),
    quarantine_complaints[rejection_reason] = "UNASSIGNED_BOROUGH"
)

Invalid ZIP Codes = 
CALCULATE(
    COUNTROWS(quarantine_complaints),
    quarantine_complaints[rejection_reason] = "INVALID_OR_OUT_OF_STATE_ZIP"
)


-- ------------------------------------------------------------------------------
-- FOLDER: 04 Time Intelligence
-- ------------------------------------------------------------------------------

Complaints Closed by Resolution Date = 
CALCULATE(
    [Closed Complaints],
    USERELATIONSHIP(fact_complaints[closed_date_key], dim_calendar[date_key])
)

Complaints 7D Moving Avg = 
AVERAGEX(
    DATESINPERIOD(dim_calendar[full_date], MAX(dim_calendar[full_date]), -7, DAY),
    [Total Complaints]
)
